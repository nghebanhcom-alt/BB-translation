# Copy to .env and fill in real values. .env must NOT be committed.

CLAUDE_API_KEY=
OPENAI_API_KEY=
DEEPL_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_ENDPOINT=http://host.docker.internal:11434
# MinerU OCR — Architecture.md 6.9.8
#   macOS (native, khuyen nghi): mineru-api --host 127.0.0.1 --port 8010
#     -> http://localhost:8010    (8000 da bi FastAPI cua app chiem)
#   Docker sidecar (Linux/NVIDIA): -> http://mineru:8000
MINERU_ENDPOINT=http://localhost:8010
MINERU_TASK_TIMEOUT_SECONDS=3600
MINERU_REQUEST_TIMEOUT_SECONDS=120
OCR_CONFIDENCE_THRESHOLD=0.80

DATABASE_URL=sqlite+aiosqlite:///data/bb_translation.db

MAX_CONCURRENT_FILES=3
MAX_UPLOAD_SIZE_MB=500
LOG_LEVEL=info

NOTO_FONT_PATH=fonts/BeVietnamPro-Regular.ttf
